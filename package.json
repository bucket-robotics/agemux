{
  "name": "agemux",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/main.ts --target=bun --external '@opentui/core-*' --outdir ./dist",
    "check": "bun test && bun run typecheck && bun run build && bun ./dist/main.js --help && test \"$(bun ./dist/main.js --version)\" = \"0.1.1\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.5.4",
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
