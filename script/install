#!/bin/sh
set -eu

repository=${AGEMUX_REPOSITORY:-bucket-robotics/agemux}
destination=${AGEMUX_INSTALL_DIR:-"${HOME:?HOME is required}/.local/bin"}
application_root=${AGEMUX_APPLICATION_DIR:-"${XDG_DATA_HOME:-$HOME/.local/share}/agemux"}
tag=${AGEMUX_VERSION:-}

fail() {
  echo "agemux: $1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

require_macos_13() {
  [ "$(uname -s)" = Darwin ] || return 0
  require_command sw_vers
  macos_version=$(sw_vers -productVersion)
  macos_major=${macos_version%%.*}
  case "$macos_major" in
    '' | *[!0-9]*) fail "could not determine the macOS version" ;;
  esac
  [ "$macos_major" -ge 13 ] || fail "macOS 13 or newer is required"
}

select_platform() {
  case "$(uname -s):$(uname -m)" in
    Darwin:arm64)
      platform=darwin-arm64
      bun_archive=bun-darwin-aarch64.zip
      bun_directory=bun-darwin-aarch64
      bun_checksum=d8b96221828ad6f97ac7ac0ab7e95872341af763001e8803e8267652c2652620
      ;;
    Darwin:x86_64)
      platform=darwin-x64
      bun_archive=bun-darwin-x64-baseline.zip
      bun_directory=bun-darwin-x64-baseline
      bun_checksum=3e35ad6f53971a9834bf9e6786e2adf72b5f1921cc9a9c5fde073d2972944076
      ;;
    Linux:aarch64 | Linux:arm64)
      platform=linux-arm64
      bun_archive=bun-linux-aarch64.zip
      bun_directory=bun-linux-aarch64
      bun_checksum=a27ffb63a8310375836e0d6f668ae17fa8d8d18b88c37c821c65331973a19a3b
      ;;
    Linux:x86_64 | Linux:amd64)
      platform=linux-x64
      bun_archive=bun-linux-x64-baseline.zip
      bun_directory=bun-linux-x64-baseline
      bun_checksum=a063908ae08b7852ca10939bbdc6ceed3ddabce8fb9402dce83d65d73b36e6c7
      ;;
    *) fail "unsupported platform: $(uname -s) $(uname -m)" ;;
  esac
}

require_linux_runtime() {
  [ "$(uname -s)" = Linux ] || return 0
  require_command ldd
  case "$(ldd --version 2>&1 || true)" in
    *musl*) fail "musl Linux is not supported; glibc is required" ;;
  esac
  require_command getconf
  glibc_version=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{ print $2 }' || true)
  glibc_major=${glibc_version%%.*}
  glibc_minor=${glibc_version#*.}
  glibc_minor=${glibc_minor%%.*}
  case "$glibc_major:$glibc_minor" in
    *[!0-9:]* | :* | *:) fail "could not determine the glibc version" ;;
  esac
  if [ "$glibc_major" -lt 2 ] || { [ "$glibc_major" -eq 2 ] && [ "$glibc_minor" -lt 17 ]; }; then
    fail "glibc 2.17 or newer is required"
  fi
}

require_sse42_on_x64() {
  [ "$(uname -m)" = x86_64 ] || return 0
  case "$(uname -s)" in
    Darwin)
      require_command sysctl
      sysctl -n machdep.cpu.features 2>/dev/null | grep -Eqi '(^|[[:space:]])SSE4\.2([[:space:]]|$)' ||
        fail "an x64 CPU with SSE4.2 is required"
      ;;
    Linux)
      grep -Eq '(^|[[:space:]])sse4_2([[:space:]]|$)' /proc/cpuinfo ||
        fail "an x64 CPU with SSE4.2 is required"
      ;;
  esac
}

fetch() {
  curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
    "$1" --output "$2"
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    shasum -a 256 "$1" | awk '{ print $1 }'
  fi
}

verify_checksum() {
  [ "$(sha256 "$1")" = "$2" ] || fail "checksum mismatch for $3"
}

install_bun() {
  bun_runtime="$application_root/runtime/bun-1.3.14-$bun_checksum"
  bun_executable="$bun_runtime/bun"
  if [ -d "$bun_runtime" ]; then
    [ "$(cat "$bun_runtime/ARCHIVE_SHA256" 2>/dev/null || true)" = "$bun_checksum" ] ||
      fail "the installed Bun runtime is incomplete: $bun_runtime"
    [ -x "$bun_executable" ] || fail "the installed Bun runtime is incomplete: $bun_runtime"
    [ -s "$bun_runtime/LICENSE.md" ] || fail "the installed Bun runtime is incomplete: $bun_runtime"
    return
  fi

  bun_release=https://github.com/oven-sh/bun/releases/download/bun-v1.3.14
  fetch "$bun_release/$bun_archive" "$temporary/$bun_archive"
  verify_checksum "$temporary/$bun_archive" "$bun_checksum" "$bun_archive"
  unzip -q "$temporary/$bun_archive" -d "$temporary/bun"

  fetch https://raw.githubusercontent.com/oven-sh/bun/bun-v1.3.14/LICENSE.md "$temporary/BUN_LICENSE.md"
  verify_checksum "$temporary/BUN_LICENSE.md" 2c6160ec8fb853f7e8f97d9b249e756c9b0ac44860a68b6bf4f1b0bcbc5c3741 BUN_LICENSE.md

  mkdir -p "$application_root/runtime"
  staged_runtime=$(mktemp -d "$application_root/runtime/.install.XXXXXX")
  install -m 0755 "$temporary/bun/$bun_directory/bun" "$staged_runtime/bun"
  install -m 0644 "$temporary/BUN_LICENSE.md" "$staged_runtime/LICENSE.md"
  printf '%s\n' "$bun_checksum" > "$staged_runtime/ARCHIVE_SHA256"
  mv "$staged_runtime" "$bun_runtime"
  staged_runtime=
}

select_release() {
  if [ -n "$tag" ]; then
    release="https://github.com/${repository}/releases/download/${tag}"
  else
    release="https://github.com/${repository}/releases/latest/download"
  fi
  archive="agemux-${platform}.tar.gz"
}

download_release() {
  fetch "$release/$archive" "$temporary/$archive"
  fetch "$release/checksums.txt" "$temporary/checksums.txt"
}

verify_release() {
  expected=$(awk -v file="$archive" '$2 == file { print $1 }' "$temporary/checksums.txt")
  [ -n "$expected" ] || fail "$archive is missing from checksums.txt"
  verify_checksum "$temporary/$archive" "$expected" "$archive"
  tar -xzf "$temporary/$archive" -C "$temporary"

  version=$(cat "$temporary/agemux/VERSION")
  case "$version" in
    "" | *[!0-9A-Za-z.-]* | .* | *..*) fail "invalid release version: $version" ;;
  esac
  [ -z "$tag" ] || [ "$tag" = "v$version" ] || fail "archive version $version does not match $tag"
}

install_application() {
  application_directory="$application_root/$version"
  mkdir -p "$application_root"

  if [ -d "$application_directory" ]; then
    [ "$(cat "$application_directory/ARCHIVE_SHA256" 2>/dev/null || true)" = "$expected" ] ||
      fail "the installed application differs from release $version: $application_directory"
    [ -s "$application_directory/main.js" ] || fail "the installed application is incomplete: $application_directory"
    [ -s "$application_directory/LICENSE" ] || fail "the installed application is incomplete: $application_directory"
    [ -s "$application_directory/THIRD_PARTY_NOTICES" ] || fail "the installed application is incomplete: $application_directory"
    return
  fi

  staged_application=$(mktemp -d "$application_root/.install.XXXXXX")
  cp -R "$temporary/agemux/." "$staged_application/"
  printf '%s\n' "$expected" > "$staged_application/ARCHIVE_SHA256"
  mv "$staged_application" "$application_directory"
  staged_application=
}

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\"'\"'/g"
  printf "'"
}

install_launcher() {
  mkdir -p "$destination"
  staged_launcher=$(mktemp "$destination/.agemux.XXXXXX")
  {
    printf '#!/bin/sh\nexport AGEMUX_EXECUTABLE='
    shell_quote "$destination/agemux"
    printf '\nexec '
    shell_quote "$bun_executable"
    printf ' '
    shell_quote "$application_directory/main.js"
    printf ' "$@"\n'
  } > "$staged_launcher"

  chmod 0755 "$staged_launcher"
  mv "$staged_launcher" "$destination/agemux"
  staged_launcher=
}

report_installation() {
  echo "agemux: installed $destination/agemux"
  echo "agemux: installed application and notices in $application_directory"
  case ":${PATH}:" in
    *":${destination}:"*) ;;
    *) echo "agemux: add $destination to PATH" ;;
  esac
  echo "agemux: run 'agemux setup' once to route bare claude and codex commands through the picker"
}

cleanup() {
  rm -rf "$temporary"
  [ -z "$staged_application" ] || rm -rf "$staged_application"
  [ -z "$staged_runtime" ] || rm -rf "$staged_runtime"
  [ -z "$staged_launcher" ] || rm -f "$staged_launcher"
}

main() {
  require_command curl
  require_command unzip
  select_platform
  require_macos_13
  require_linux_runtime
  require_sse42_on_x64

  temporary=$(mktemp -d "${TMPDIR:-/tmp}/agemux-install.XXXXXX")
  staged_application=
  staged_runtime=
  staged_launcher=
  trap cleanup EXIT
  trap 'exit 1' HUP INT TERM

  install_bun
  select_release
  download_release
  verify_release
  install_application
  install_launcher
  report_installation
}

main "$@"
